# Copiá este archivo como .env y completá los valores reales.
# El archivo .env NO se versiona (está en .gitignore).

# --- Django ---
# Generá una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=False
# En producción (DJANGO_DEBUG=False) declarar los hosts separados por coma.
# Con Cloudflare Tunnel poné el hostname público + localhost:
DJANGO_ALLOWED_HOSTS=portal.tudominio.com,127.0.0.1,localhost

# --- HTTPS / proxy (Cloudflare Tunnel termina el TLS) ---
# Confiar en la cabecera X-Forwarded-Proto del túnel. Default: True cuando DEBUG=False.
USE_PROXY_SSL_HEADER=True
# Cookies seguras (el tráfico público va por HTTPS vía Cloudflare). Default: True cuando DEBUG=False.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Dejar en False detrás de Cloudflare (Cloudflare hace "Always Use HTTPS"; forzarlo acá puede dar bucles).
SECURE_SSL_REDIRECT=False
# HSTS: solo con dominio propio estable (NUNCA en *.trycloudflare.com). 0 = desactivado.
SECURE_HSTS_SECONDS=0
# Orígenes confiables para CSRF (tu hostname público de Cloudflare), separados por coma:
CSRF_TRUSTED_ORIGINS=https://portal.tudominio.com

# --- Google OAuth (allauth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- RADIUS (router ER605 / FreeRADIUS) ---
RADIUS_SERVER=127.0.0.1
RADIUS_SECRET=secret_omada
RADIUS_DICT_PATH=/usr/share/freeradius/dictionary.rfc2865
# True en desarrollo para saltar la validación RADIUS; False en producción.
DEBUG_SKIP_RADIUS=False

# --- Gunicorn (opcional) ---
GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
