[Unit]
Description=mi_portal - Portal cautivo IPF (Django + Gunicorn)
After=network.target

[Service]
Type=notify
# Ajustá usuario/grupo y ruta a donde clonaste el proyecto.
User=ipf
Group=ipf
WorkingDirectory=/opt/mi_portal
EnvironmentFile=/opt/mi_portal/.env
ExecStart=/opt/mi_portal/venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
Restart=on-failure
RestartSec=3

# Endurecimiento básico del servicio
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
